<Window x:Class="TourCraft.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TourCraft · Туристическое агентство" Width="1040" Height="660" MinWidth="780" MinHeight="480" Background="#F6F7F2" WindowStartupLocation="CenterScreen" Loaded="Refresh">
<DockPanel>
 <Border DockPanel.Dock="Top" Background="#164C48" Padding="24,16"><StackPanel><TextBlock Foreground="White" FontSize="26" FontWeight="SemiBold">TourCraft</TextBlock><TextBlock Foreground="#D1E5DC">Рабочее место туристического агентства</TextBlock></StackPanel></Border>
 <DockPanel DockPanel.Dock="Bottom" Margin="16,4"><Button DockPanel.Dock="Right" Click="Refresh" Content="Обновить"/><TextBlock Name="Status" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 <TabControl Margin="16" Name="Sections" SelectionChanged="Changed">
  <TabItem Header="Маршруты"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBox Name="Search" Width="220" MaxLength="160" ToolTip="Название маршрута или направления"/><Button Content="Найти" Click="Refresh"/><Button Content="Добавить" Click="NewTour"/><Button Content="Изменить" Click="EditTour"/><Button Content="Удалить" Click="DeleteTour"/></WrapPanel><DataGrid Name="ToursGrid"/></DockPanel></TabItem>
  <TabItem Header="Отправления"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><CheckBox Name="OnlyOpen" Content="Только открытый набор" VerticalAlignment="Center" Margin="4" Click="Refresh"/><Button Content="Добавить" Click="NewDeparture"/><Button Content="Открыть / закрыть набор" Click="ChangeStatus"/><Button Content="Забронировать" Click="Book"/></WrapPanel><DataGrid Name="DeparturesGrid"/></DockPanel></TabItem>
  <TabItem Header="Клиенты"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="Добавить клиента" Click="NewCustomer"/></WrapPanel><DataGrid Name="CustomersGrid"/></DockPanel></TabItem>
  <TabItem Header="Бронирования"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="Отменить бронь" Click="Cancel"/><Button Content="Принять оплату" Click="Pay"/></WrapPanel><DataGrid Name="ReservationsGrid"/></DockPanel></TabItem>
  <TabItem Header="Платежи"><DockPanel Margin="10"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"></WrapPanel><DataGrid Name="PaymentsGrid"/></DockPanel></TabItem>
 <TabItem Header="Отчёты"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock FontSize="17" Margin="0,5">Популярность направлений</TextBlock><DataGrid Grid.Row="1" Name="PopularityGrid"/><TextBlock Grid.Row="2" FontSize="17" Margin="0,8">Загрузка отправлений</TextBlock><DataGrid Grid.Row="3" Name="OccupancyGrid"/></Grid></TabItem>
 </TabControl>
</DockPanel></Window>
